rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // USERS: все операции требуют авторизацию.
    // Публичное чтение ЗАКРЫТО (пароли хранятся в документе).
    // Баланс: обновление разрешено авторизованным (транзакции, покупки, переводы).
    // Роль: поле role нельзя менять при обновлении (защита от эскалации привилегий).
    // =============================================
    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['username', 'password', 'balance', 'role', 'inventory'])
        && request.resource.data.username is string
        && request.resource.data.balance is number
        && request.resource.data.role is string;

      // Обновление: разрешено (баланс, инвентарь, профиль).
      // Поле role нельзя менять — защита от эскалации.
      allow update: if request.auth != null
        && (
          !('role' in request.resource.data)
          || request.resource.data.role == resource.data.role
        );

      allow delete: if request.auth != null;
    }

    // =============================================
    // ITEMS (каталог магазина): чтение и запись только авторизованным.
    // =============================================
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =============================================
    // LOGS: только авторизованные могут читать/создавать.
    // Логи иммутабельны (update/delete запрещены).
    // =============================================
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // =============================================
    // META: денормализованные справочники (meta/usernames и т.п.).
    // Читают все авторизованные; пишут админ-операции и ленивый
    // bootstrap из StoreService.getUsernamesFromMeta.
    // =============================================
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // =============================================
    // DEFAULT: всё остальное запрещено
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
